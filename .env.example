# The public origin this site is served from — protocol, no trailing slash.
# Canonical URLs, Open Graph tags, the sitemap and JSON-LD all derive from it.
# Set this in Vercel (Project → Settings → Environment Variables) whenever the
# production domain changes. Leaving it unset falls back to jsstheprintzone.com.
NEXT_PUBLIC_SITE_URL=https://jsstheprintzone.com

# ── Leads dashboard (/admin/leads) ───────────────────────────────────────
# Full setup steps: docs/leads-dashboard.md
#
# Password for the owner dashboard. Long and random; changing it logs every
# device out.
ADMIN_PASSWORD=

# The Apps Script web app attached to the leads spreadsheet. The URL comes
# from Deploy → Manage deployments (ends in /exec); the secret must match the
# SECRET line at the top of the script.
LEADS_SCRIPT_URL=
LEADS_SCRIPT_SECRET=

# Optional: the spreadsheet's normal URL, for the "Open Google Sheet" button.
LEADS_SHEET_URL=
