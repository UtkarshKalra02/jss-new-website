# The public origin this site is served from — protocol, no trailing slash.
# Canonical URLs, Open Graph tags, the sitemap and JSON-LD all derive from it.
# Set this in Vercel (Project → Settings → Environment Variables) whenever the
# production domain changes. Leaving it unset falls back to the www host, which
# is what production serves on — keep these in agreement or canonicals will
# point at a URL that redirects.
NEXT_PUBLIC_SITE_URL=https://www.jsstheprintzone.com

# ── Lead capture ─────────────────────────────────────────────────────────
# Full setup steps: docs/leads-dashboard.md
#
# The Apps Script web app attached to the leads spreadsheet. The URL comes
# from Deploy → Manage deployments (ends in /exec); the secret must match the
# WEBSITE_SECRET line at the top of the script. The dashboard itself is served
# by the same script, at the same URL.
LEADS_SCRIPT_URL=
LEADS_SCRIPT_SECRET=

# ── Google Search Console ────────────────────────────────────────────────
# The random string from Search Console's "HTML tag" verification method —
# the content="..." value only, NOT the whole <meta> tag. Leave it unset and
# no verification tag is rendered. Setting it in Vercel and redeploying is
# all that is needed; no code change.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
